# Line endings: store everything as LF in the repo and check it out as LF
# on every OS, so working files hash identically across machines and the
# copy-paste md5 checks stop drifting after a pull.
* text=auto eol=lf

# Python source: force text handling and use Python-aware diff hunk
# headers, so Git shows the enclosing def/class on each hunk.
*.pxd text diff=python
*.py  text diff=python
*.py3 text diff=python
*.pyw text diff=python
*.pyx text diff=python
*.pyz text diff=python
*.pyi text diff=python

# Jupyter notebooks stay text, always LF.
*.ipynb text eol=lf

# Binary: never normalised or line-ending-converted.
*.png    binary
*.ico    binary
*.gif    binary
*.jpg    binary
*.jpeg   binary
*.db     binary
*.p      binary
*.pkl    binary
*.pickle binary
*.pyc    binary export-ignore
*.pyo    binary export-ignore
*.pyd    binary